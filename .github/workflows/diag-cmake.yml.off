name: Winsock connect diagnostic

# Why do some of the cosmocc bundle CMake's processes fail every connect on Windows ("Immediate
# connect fail ... win32 error 10022")? Each job downloads with CMake many times, directly
# (cmake -P) and as the simulator's configure does (FetchContent: cmake, ninja, cmake -P), and
# keeps the logs of the failures. Variants: the CMake of release 46 and of release 54, and a
# CMake built with release 54's toolchain and its normal (not tiny) libc, which can trace system
# calls (STRACE=1), function calls (QS_FTRACE=1, see ftrace_env.c), or both: release
# cosmocc-2026.11.18-54-tracing-cmake, from build-tracing-cmake.yml.

on: push

permissions:
  contents: read

env:
  MIRROR: https://github.com/spaceface777/q_simulator/releases/download

jobs:
  connect:
    name: ${{ matrix.variant }} ${{ matrix.os }} ${{ matrix.shell }}
    runs-on: ${{ matrix.os }}
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        os: [windows-2022, windows-2025]
        shell: [cmd, pwsh]
        variant: [release-46, release-54, strace, ftrace, strace-ftrace]
    env:
      RELEASE: ${{ matrix.variant == 'release-46' && '2026.11.17-46' || '2026.11.18-54' }}
      TRACING: ${{ (matrix.variant == 'strace' || matrix.variant == 'ftrace' || matrix.variant == 'strace-ftrace') && '1' || '' }}
      LOOP_STRACE: ${{ (matrix.variant == 'strace' || matrix.variant == 'strace-ftrace') && '1' || '' }}
      LOOP_FTRACE: ${{ (matrix.variant == 'ftrace' || matrix.variant == 'strace-ftrace') && '1' || '' }}
      DIRECT: ${{ (matrix.variant == 'ftrace' || matrix.variant == 'strace-ftrace') && '15' || '40' }}
      CHAIN: ${{ (matrix.variant == 'ftrace' || matrix.variant == 'strace-ftrace') && '15' || '25' }}
    steps:
      - uses: actions/checkout@v5
        with:
          persist-credentials: false

      - name: Install cosmocc
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          Set-Location $env:RUNNER_TEMP
          foreach ($file in 'cosmocc.tar.xz', 'bsdtar', 'install.ps1') {
            Invoke-WebRequest -UseBasicParsing -Uri "$env:MIRROR/cosmocc-$env:RELEASE/$file" -OutFile $file
          }
          Move-Item bsdtar bsdtar.exe
          $env:COSMOCC_ARCHIVE = "$env:RUNNER_TEMP\cosmocc.tar.xz"
          $env:COSMOCC_BSDTAR = "$env:RUNNER_TEMP\bsdtar.exe"
          $env:COSMOCC_DIR = "$env:RUNNER_TEMP\cosmocc"
          ./install.ps1
          "COSMOCC_DIR=$env:COSMOCC_DIR" >> $env:GITHUB_ENV

      - name: Put the tracing CMake in the bundle
        if: env.TRACING == '1'
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          # Built and checked by build-tracing-cmake.yml (run 44324270007).
          New-Item -ItemType Directory "$env:RUNNER_TEMP\tracing" | Out-Null
          Invoke-WebRequest -UseBasicParsing -Uri "$env:MIRROR/cosmocc-2026.11.18-54-tracing-cmake/cmake" -OutFile "$env:RUNNER_TEMP\tracing\cmake"
          if ((Get-FileHash -Algorithm SHA256 "$env:RUNNER_TEMP\tracing\cmake").Hash -ne '938C599B92A1D9603E3700D8F2D1B86B0F4BF2B2F8119ACD416CEE720D10461A') { throw 'checksum mismatch: tracing cmake' }
          # bin\cmake.exe is a hard link to bin\cmake: replace both names.
          $bin = "$env:COSMOCC_DIR\bin"
          foreach ($name in 'cmake', 'cmake.exe') {
            Remove-Item -Force "$bin\$name"
            Copy-Item "$env:RUNNER_TEMP\tracing\cmake" "$bin\$name"
            if (Test-Path "$env:RUNNER_TEMP\tracing\cmake.dbg") { Copy-Item -Force "$env:RUNNER_TEMP\tracing\cmake.dbg" "$bin\$name.dbg" }
          }
          Get-ChildItem "$bin\cmake*" | Format-Table Name, Length

      - name: Download (cmd)
        if: matrix.shell == 'cmd'
        shell: cmd
        run: |
          for /f "usebackq delims=" %%L in (`"%COSMOCC_DIR%\bin\cosmocc-env.exe" activate cmd --path^=replace`) do %%L
          mkdir "%RUNNER_TEMP%\logs"
          set STRACE=%LOOP_STRACE%
          set QS_FTRACE=%LOOP_FTRACE%
          for /L %%i in (1,1,%DIRECT%) do cmake "-DOUT=%RUNNER_TEMP%\x%%i.html" -P "%GITHUB_WORKSPACE%\dl.cmake" > "%RUNNER_TEMP%\logs\direct-%%i.log" 2>&1
          for /L %%i in (1,1,%CHAIN%) do (cmake -S "%GITHUB_WORKSPACE%\chain" -B "%RUNNER_TEMP%\chain-%%i" -G Ninja -DFETCHCONTENT_QUIET=OFF -DCMAKE_TLS_CAINFO=/zip/usr/share/ssl/cert.pem > "%RUNNER_TEMP%\logs\chain-%%i.log" 2>&1 || echo CHAIN-FAILED>> "%RUNNER_TEMP%\logs\chain-%%i.log")
          exit /b 0

      - name: Download (PowerShell)
        if: matrix.shell == 'pwsh'
        shell: pwsh
        run: |
          . "$env:COSMOCC_DIR\activate.ps1" --path=replace
          New-Item -ItemType Directory "$env:RUNNER_TEMP\logs" | Out-Null
          $env:STRACE = $env:LOOP_STRACE
          $env:QS_FTRACE = $env:LOOP_FTRACE
          foreach ($i in 1..[int]$env:DIRECT) {
            cmake "-DOUT=$env:RUNNER_TEMP\x$i.html" -P "$env:GITHUB_WORKSPACE\dl.cmake" *> "$env:RUNNER_TEMP\logs\direct-$i.log"
          }
          foreach ($i in 1..[int]$env:CHAIN) {
            $log = "$env:RUNNER_TEMP\logs\chain-$i.log"
            cmake -S "$env:GITHUB_WORKSPACE\chain" -B "$env:RUNNER_TEMP\chain-$i" -G Ninja -DFETCHCONTENT_QUIET=OFF "-DCMAKE_TLS_CAINFO=/zip/usr/share/ssl/cert.pem" *> $log
            if ($LASTEXITCODE) { Add-Content $log CHAIN-FAILED }
          }
          exit 0

      - name: Count
        if: always()
        shell: bash
        run: |
          cd "$RUNNER_TEMP/logs"
          mkdir -p "$RUNNER_TEMP/keep"
          total() { ls $1-*.log | wc -l; }
          direct_failed=0 chain_failed=0
          # (bash -e: if statements, so that a log without a failure does not end the step)
          for f in direct-*.log; do
            if ! grep -q '^RESULT 0' "$f"; then direct_failed=$((direct_failed + 1)); cp "$f" "$RUNNER_TEMP/keep/"; fi
          done
          for f in chain-*.log; do
            if grep -q 'CHAIN-FAILED' "$f"; then chain_failed=$((chain_failed + 1)); cp "$f" "$RUNNER_TEMP/keep/"; fi
          done
          summary="${{ matrix.variant }} ${{ matrix.os }} ${{ matrix.shell }}: cmake -P failed $direct_failed of $(total direct), FetchContent failed $chain_failed of $(total chain)"
          echo "::notice::$summary"
          echo "$summary" > "$RUNNER_TEMP/keep/summary.txt"
          # The first of each kept as a sample, and as proof that the switches reached the
          # download process: a trace of connect() (strace) or of curl's functions (ftrace).
          cp direct-1.log chain-1.log "$RUNNER_TEMP/keep/" 2>/dev/null || true
          fail=0
          for f in direct-1.log chain-1.log; do
            if [ "$LOOP_STRACE" = 1 ] && ! grep -q 'connect(' "$f"; then echo "::error::$f: STRACE=1 did not reach the download"; fail=1; fi
            if [ "$LOOP_FTRACE" = 1 ] && ! grep -q 'Curl_' "$f"; then echo "::error::$f: QS_FTRACE=1 did not reach the download"; fail=1; fi
          done
          for f in "$RUNNER_TEMP"/keep/direct-*.log "$RUNNER_TEMP"/keep/chain-*.log; do
            [ -f "$f" ] || continue
            if [ "$(basename "$f")" = direct-1.log ] && grep -q '^RESULT 0' "$f"; then continue; fi
            if [ "$(basename "$f")" = chain-1.log ] && ! grep -q 'CHAIN-FAILED' "$f"; then continue; fi
            echo "--- $f"; grep -aE 'connect|Connect|bind\(|RESULT|CHAIN-FAILED' "$f" | head -20 || true
          done
          exit $fail

      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: logs-${{ matrix.variant }}-${{ matrix.os }}-${{ matrix.shell }}
          path: ${{ runner.temp }}/keep/
