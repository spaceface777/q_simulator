+#if defined(UV_USE_COSMO_POSIX_SPAWN)
+    if (fd == use_fd) {
+      /* An inherited descriptor in place: clear FD_CLOEXEC in the child, as
+       * the fork/exec flow does, by a round trip through a spare number.
+       * dup2() of a descriptor onto itself would keep the flag. */
+      int r = fcntl(fd, F_GETFD);
+      if (r == -1) {
+        err = errno;
+      } else if (r & FD_CLOEXEC) {
+        int spare = stdio_count;
+        for (fd2 = 0; fd2 < stdio_count; fd2++) {
+          if (pipes[fd2][1] == spare) {
+            spare++;
+            fd2 = -1;
+          }
+        }
+        err = posix_spawn_file_actions_adddup2(actions, fd, spare);
+        if (err == 0)
+          err = posix_spawn_file_actions_adddup2(actions, spare, fd);
+        if (err == 0)
+          err = posix_spawn_file_actions_addclose(actions, spare);
+      } else {
+        err = 0;
+      }
+    }
+#else
     if (fd == use_fd)
         err = posix_spawn_file_actions_addinherit_np(actions, fd);
+#endif
     else
         err = posix_spawn_file_actions_adddup2(actions, use_fd, fd);
     assert(err != ENOSYS);
