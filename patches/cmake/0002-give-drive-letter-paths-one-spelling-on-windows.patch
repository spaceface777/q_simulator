+
+#ifdef __COSMOPOLITAN__
+namespace {
+bool CosmoIsLetter(char c)
+{
+  return ('A' <= c && c <= 'Z') || ('a' <= c && c <= 'z');
+}
+
+char CosmoUpper(char c)
+{
+  return ('a' <= c && c <= 'z') ? static_cast<char>(c - 'a' + 'A') : c;
+}
+
+// Directory <rest> ("" or "/...") of a drive, as __mkunixpath() spells it.
+std::string CosmoDrivePath(char drive, std::string const& rest)
+{
+  drive = CosmoUpper(drive);
+  if (drive == CosmoUpper(__getcosmosdrive())) {
+    // "/x" names the system drive, unless x is one letter: "/d" is drive D.
+    bool letter = rest.size() >= 2 && CosmoIsLetter(rest[1]) &&
+      (rest.size() == 2 || rest[2] == '/');
+    if (!letter) {
+      return rest.empty() ? std::string("/") : rest;
+    }
+  }
+  return std::string(1, '/') + drive + rest;
+}
+
+// The working directory of a drive, as Windows finds it for "D:x": the
+// current directory if it is on that drive, else the "=D:" variable that
+// cmd.exe keeps, else the root of the drive.
+std::string CosmoDriveDirectory(char drive)
+{
+  std::string cwd = SystemTools::GetCurrentWorkingDirectory();
+  char cwdDrive = __getcosmosdrive();
+  if (cwd.size() >= 2 && cwd[0] == '/' && CosmoIsLetter(cwd[1]) &&
+      (cwd.size() == 2 || cwd[2] == '/')) {
+    cwdDrive = cwd[1];
+  }
+  if (CosmoUpper(cwdDrive) == CosmoUpper(drive)) {
+    return cwd;
+  }
+  for (char** e = environ; e && *e; ++e) {
+    char const* v = *e;
+    if (v[0] == '=' && CosmoUpper(v[1]) == CosmoUpper(drive) &&
+        v[2] == ':' && v[3] == '=' && CosmoIsLetter(v[4]) && v[5] == ':' &&
+        (v[6] == '/' || v[6] == '\\')) {
+      std::string dir = v + 4;
+      SystemTools::ConvertToCosmoPath(dir);
+      return dir;
+    }
+  }
+  return CosmoDrivePath(drive, "");
+}
+}
+#endif
+
+void SystemTools::ConvertToCosmoPath(std::string& path)
+{
+#ifdef __COSMOPOLITAN__
+  if (path.size() < 2 || !CosmoIsWindows()) {
+    return;
+  }
+
+  // Windows file names cannot contain '\'.  The C library reads it as '/'.
+  std::replace(path.begin(), path.end(), '\\', '/');
+
+  // "//?/D:/x" and "//./D:/x" are "D:/x" without the length limit.
+  if (path.size() >= 6 && path[0] == '/' && path[1] == '/' &&
+      (path[2] == '?' || path[2] == '.') && path[3] == '/' &&
+      CosmoIsLetter(path[4]) && path[5] == ':') {
+    path.erase(0, 4);
+  }
+
+  if (CosmoIsLetter(path[0]) && path[1] == ':') {
+    if (path.size() > 2 && path[2] == '/') {
+      // "D:/x" is absolute.
+      path = CosmoDrivePath(path[0], path.substr(2));
+    } else if (path.size() == 2 || path[2] != ':') {
+      // "D:x" is relative to the working directory of drive D.
+      // ("A::B" is a target name, not a path.)
+      std::string dir = CosmoDriveDirectory(path[0]);
+      if (path.size() > 2) {
+        if (dir.back() != '/') {
+          dir += '/';
+        }
+        dir.append(path, 2, std::string::npos);
+      }
+      path = std::move(dir);
     }
+  } else if (path[0] == '/' && CosmoIsLetter(path[1]) &&
+             (path.size() == 2 || path[2] == '/')) {
+    // "/d/x" is another spelling of "/D/x", and "/c/x" of "/x".
+    path = CosmoDrivePath(path[1], path.substr(2));
   }
+#else
+  static_cast<void>(path);
+#endif
 }
 
