Subject: Use libuv's POSIX backend on Cosmopolitan

--- a/Utilities/cmlibuv/CMakeLists.txt
+++ b/Utilities/cmlibuv/CMakeLists.txt
@@ -199,7 +199,19 @@
     )
 endif()
 
-if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+if(CMAKE_C_COMPILER MATCHES "cosmo")
+  list(APPEND uv_headers include/uv/posix.h)
+  list(APPEND uv_defines _GNU_SOURCE)
+  list(APPEND uv_sources
+    src/unix/no-fsevents.c
+    src/unix/no-proctitle.c
+    src/unix/posix-hrtime.c
+    src/unix/posix-poll.c
+    src/unix/procfs-exepath.c
+    src/unix/sysinfo-loadavg.c
+    src/unix/sysinfo-memory.c
+    )
+elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
   list(APPEND uv_libraries dl rt)
   list(APPEND uv_headers
     include/uv/linux.h
--- a/Utilities/cmlibuv/include/uv/unix.h
+++ b/Utilities/cmlibuv/include/uv/unix.h
@@ -50,7 +50,7 @@
 # if defined(__APPLE__)
 #  include <TargetConditionals.h>
 # endif
-#elif defined(__linux__)
+#elif defined(__linux__) && !defined(__COSMOPOLITAN__)
 # include "linux.h"
 #elif defined (__MVS__)
 # include "os390.h"
@@ -73,7 +73,8 @@
       defined(__MSYS__)   || \
       defined(__HAIKU__)  || \
       defined(__QNX__)    || \
-      defined(__GNU__)
+      defined(__GNU__)    || \
+      defined(__COSMOPOLITAN__)
 # include "posix.h"
 #endif
 
--- a/Utilities/cmlibuv/src/unix/getaddrinfo.c
+++ b/Utilities/cmlibuv/src/unix/getaddrinfo.c
@@ -228,8 +228,12 @@
   if (buffer == NULL || size == NULL || *size == 0)
     return UV_EINVAL;
 
+#ifdef __COSMOPOLITAN__
+  return UV_ENOSYS;
+#else
   if (if_indextoname(ifindex, ifname_buf) == NULL)
     return UV__ERR(errno);
+#endif
 
   len = strnlen(ifname_buf, sizeof(ifname_buf));
 
--- a/Utilities/cmlibuv/src/unix/udp.c
+++ b/Utilities/cmlibuv/src/unix/udp.c
@@ -847,6 +847,7 @@
     !defined(__DragonFly__) &&                                      \
     (!defined(__APPLE__) || (MAC_OS_X_VERSION_MAX_ALLOWED >= 1070)) && \
     !defined(__GNU__) &&                                            \
+    !defined(__COSMOPOLITAN__) &&                                   \
     !defined(QNX_IOPKT)
 static int uv__udp_set_source_membership4(uv_udp_t* handle,
                                           const struct sockaddr_in* multicast_addr,
@@ -1061,6 +1062,7 @@
     !defined(__DragonFly__) &&                                      \
     (!defined(__APPLE__) || (MAC_OS_X_VERSION_MAX_ALLOWED >= 1070)) && \
     !defined(__GNU__) &&                                            \
+    !defined(__COSMOPOLITAN__) &&                                   \
     !defined(QNX_IOPKT)
   int err;
   union uv__sockaddr mcast_addr;
--- a/Utilities/cmlibuv/src/uv-common.c
+++ b/Utilities/cmlibuv/src/uv-common.c
@@ -287,7 +287,7 @@
 
     zone_index++; /* skip '%' */
     /* NOTE: unknown interface (id=0) is silently ignored */
-#ifdef _WIN32
+#if defined(_WIN32) || defined(__COSMOPOLITAN__)
     addr->sin6_scope_id = atoi(zone_index);
 #else
     addr->sin6_scope_id = if_nametoindex(zone_index);
