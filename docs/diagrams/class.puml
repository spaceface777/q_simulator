@startuml Class diagram
package Simulation {

hide empty members
class mainS as "main" {}

class "sim::Runtime" {
 void start()
 void advance(microseconds, double, microseconds)
 void load(events::Schedule)
 void load_properties(ltl::File, uint64_t)
 void stop()
 uint64_t tick()
}

class "world::State" {
 void add_module(ModuleId)
 void place(uint8_t, ModuleId, Position, RfidUid, RfidPayload)
 void remove(uint8_t)
 void advance_tick()
 const Module* module(ModuleId)
}

class "platform::Manager" {
 optional<Frame> handle_request(ModuleId, Frame, uint64_t)
 void advance(uint64_t)
 vector<Frame> take_outbound(ModuleId, size_t)
}

class "firmware::InProcessBackend" {
 void execute_epoch(span<ExecutionGrant>)
 void retire(ModuleId)
}

class "ltl::Monitor" {
 void step(AtomEvaluator, AtomValueEvaluator, DomainEnumerator)
 void finish()
 Verdict verdict()
}

class Visualization {
 void update(const world::State&, const VirtualClock&)
}

}

package "Firmware image" {
 hide empty members
 class app as "application main" {}
 class image as "qsim_image_api_t" {
  int bind(uint32_t, uint8_t, const qsim_env_entry_t*, size_t)
  int run(uint64_t, uint64_t, const quercus_mailbox_t*, quercus_mailbox_t*, uint64_t*)
 }
}

mainS "1" *-- "sim::Runtime"
mainS "1" *-- Visualization
"sim::Runtime" "1" *-- "world::State"
"sim::Runtime" "1" *-- "platform::Manager"
"sim::Runtime" "1" *-- "firmware::InProcessBackend"
"sim::Runtime" "0..n" *-- "ltl::Monitor"
"firmware::InProcessBackend" "1..n" --> image : runs grants
image --> app : runs
@enduml
