@startuml Class diagram
hide empty members
package Simulation {
  class main
  class "sim::Runtime"
  class "world::State"
  class "platform::Manager"
  class "net::Model"
  class "ltl::Monitor"
  class "firmware::InProcessBackend"
  class "firmware::LoadedImage"
  class Visualization
}
package "Private firmware image (one per module)" {
  class "qsim_image_api_t" {
    bind(config)
    run(grant, result)
    destroy()
  }
  class "Zephyr kernel and coroutine runner"
  class Application
}
main "1" *-- "sim::Runtime"
main "1" *-- Visualization
"sim::Runtime" "1" *-- "world::State"
"sim::Runtime" "1" *-- "platform::Manager"
"platform::Manager" "1" *-- "net::Model"
"sim::Runtime" "0..n" *-- "ltl::Monitor"
"sim::Runtime" "1" *-- "firmware::InProcessBackend"
"firmware::InProcessBackend" "1..n" *-- "firmware::LoadedImage"
"firmware::LoadedImage" --> "qsim_image_api_t" : loads a private copy
"qsim_image_api_t" --> "Zephyr kernel and coroutine runner" : grants native time
"Zephyr kernel and coroutine runner" --> Application : schedules
Visualization --> "sim::Runtime" : reads world and pacing state
@enduml
