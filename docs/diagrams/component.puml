@startuml High-level component diagram

package "World process" {
    package "Firmware image (one per active module)" {
        [Application]
        [native_sim runner]

        [Application] <--> [native_sim runner] : SDK RPC
    }

    [Runtime]
    [In-process backend]
    [RPC platform]
    [Network]
    [World]
    [LTLf monitor]
    [Visualization]

    [Runtime] --> [In-process backend] : grants ticks
    [In-process backend] <--> [native_sim runner] : qsim_image_api_t, mailboxes
    [Runtime] --> [RPC platform] : dispatches frames
    [RPC platform] <--> [World] : reads and updates hardware
    [RPC platform] <--> [Network] : sends and receives packets
    [Runtime] --> [World] : advances one tick
    [Runtime] --> [LTLf monitor] : submits observations
    [Runtime] --> [Visualization] : exposes current state
}

@enduml
