@startuml High-level component diagram

package "native_sim application process" {
    [Application]
    [Lockstep adapter]

    [Application] <--> [Lockstep adapter] : SDK RPC
}

package "Simulation process" {
    [Runtime]
    [Shared barrier]
    [RPC platform]
    [Network]
    [World]
    [LTLf monitor]
    [Visualization]

    [Runtime] <--> [Shared barrier] : grants and collects ticks
    [Runtime] --> [RPC platform] : dispatches frames
    [RPC platform] <--> [World] : reads and updates hardware
    [RPC platform] <--> [Network] : sends and receives packets
    [Runtime] --> [World] : advances one tick
    [Runtime] --> [LTLf monitor] : submits observations
    [Runtime] --> [Visualization] : exposes current state
    [Shared barrier] <--> [Lockstep adapter] : shared control
    [RPC platform] <--> [Lockstep adapter] : shared mailboxes
}

@enduml
